---
interface Item {
  title: string;
  label: string;
  url: string;
}

const navItems: Item[] = [
  {
    title: 'Experiencia',
    label: 'experiencia',
    url: '/#experience',
  },
  {
    title: 'Proyectos',
    label: 'proyectos',
    url: '/#projects',
  },
  {
    title: 'Sobre mí',
    label: 'sobre-mi',
    url: '/#about-me',
  },
  {
    title: 'Contacto',
    label: 'contacto',
    url: 'mailto:alejandro.oliva2409@gmail.com',
  },
];
---

<header class='flex justify-center mt-2'>
  <nav class='w-wrapper flex justify-center'>
    <ul class='flex justify-evenly w-3/4'>
      {
        navItems.map((item) => (
          <li>
            <a
              class='p-1.5 rounded-md hover:text-blue-600'
              aria-label={item.label}
              href={item.url}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
