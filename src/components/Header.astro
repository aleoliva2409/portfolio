---
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';

interface Item {
  title: string;
  label: string;
  url: string;
}

const navItems: Item[] = [
  {
    title: 'Experiencia',
    label: 'experiencia',
    url: '/#experience',
  },
  {
    title: 'Proyectos',
    label: 'proyectos',
    url: '/#projects',
  },
  {
    title: 'Sobre mí',
    label: 'sobre-mi',
    url: '/#about-me',
  },
  {
    title: 'Contacto',
    label: 'contacto',
    url: 'mailto:alejandro.oliva2409@gmail.com',
  },
];
---

<header
  class='fixed left-0 right-0 top-0 z-50 mt-4 flex justify-center px-2 sm:px-4'
>
  <nav
    class='flex w-fit max-w-full flex-nowrap items-center gap-0 rounded-full border border-gray-200/20 bg-white/60 px-2 py-1.5 text-xs shadow-lg ring-1 ring-white/10 backdrop-blur-md dark:border-line-dark/60 dark:bg-surface-dark/70 dark:ring-white/5 sm:gap-1 sm:px-4 sm:text-sm'
  >
    {
      navItems.map((item) => (
        <a
          class='block whitespace-nowrap rounded-full px-1.5 py-1.5 text-gray-600 transition-colors hover:bg-gray-200/50 hover:text-accent dark:text-ink-dark hover:dark:bg-white/10 hover:dark:text-accent-dark sm:px-3'
          aria-label={item.label}
          href={item.url}
        >
          {item.title}
        </a>
      ))
    }

    <div
      class='ml-1 border-l border-gray-300/30 pl-1 dark:border-white/10 sm:ml-2 sm:pl-2'
    >
      <ThemeSwitcher />
    </div>
  </nav>
</header>
