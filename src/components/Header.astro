---
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, useTranslations } from '@/i18n/utils';

interface Item {
  id: string;
  title: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeUrl = getRelativeLocaleUrl(lang);
const otherLang = lang === 'es' ? 'en' : 'es';

const navItems: Item[] = [
  {
    id: 'experience',
    title: t('nav.experience'),
  },
  {
    id: 'projects',
    title: t('nav.projects'),
  },
  {
    id: 'skills',
    title: t('nav.skills'),
  },
  {
    id: 'about-me',
    title: t('nav.about'),
  },
];
---

<header
  class='fixed left-0 right-0 top-0 z-50 mt-4 flex justify-center px-2 sm:px-4'
>
  <nav
    class='flex w-fit max-w-full flex-nowrap items-center gap-0 rounded-full border border-gray-200/20 bg-white/60 px-2 py-1.5 text-xs shadow-lg ring-1 ring-white/10 backdrop-blur-md dark:border-line-dark/60 dark:bg-surface-dark/70 dark:ring-white/5 sm:gap-1 sm:px-4 sm:text-sm'
  >
    {
      navItems.map((item) => (
        <a
          class='block whitespace-nowrap rounded-full px-1.5 py-1.5 text-gray-600 transition-colors hover:bg-gray-200/50 hover:text-accent dark:text-ink-dark hover:dark:bg-white/10 hover:dark:text-accent-dark aria-[current=true]:bg-brand/10 aria-[current=true]:font-medium aria-[current=true]:text-brand dark:aria-[current=true]:bg-brand-dark/10 dark:aria-[current=true]:text-brand-dark sm:px-3'
          href={`${homeUrl}#${item.id}`}
          data-nav-section={item.id}
        >
          {item.title}
        </a>
      ))
    }

    <div
      class='ml-1 flex items-center gap-1 border-l border-gray-300/30 pl-1 dark:border-white/10 sm:ml-2 sm:pl-2'
    >
      <a
        class='rounded-full px-1.5 py-1.5 font-medium uppercase text-gray-600 transition-colors hover:bg-gray-200/50 hover:text-accent dark:text-ink-dark hover:dark:bg-white/10 hover:dark:text-accent-dark'
        href={getRelativeLocaleUrl(otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t('nav.switchLang')}
      >
        {otherLang}
      </a>
      <ThemeSwitcher />
    </div>
  </nav>
</header>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]');

  const setActive = (id: string | null) => {
    links.forEach((link) => {
      if (link.dataset.navSection === id) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const sections = [
    ...document.querySelectorAll<HTMLElement>('[data-section]'),
  ];

  const updateActive = () => {
    const isAtBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;

    const current = isAtBottom
      ? sections.at(-1)
      : sections.findLast(
          (section) =>
            section.getBoundingClientRect().top <= window.innerHeight * 0.4,
        );

    setActive(current?.id ?? null);
  };

  window.addEventListener('scroll', updateActive, { passive: true });

  updateActive();
</script>
