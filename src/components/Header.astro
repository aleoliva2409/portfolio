---
interface Item {
  title: string;
  label: string;
  url: string;
}

const navItems: Item[] = [
  {
    title: 'Experiencia',
    label: 'experiencia',
    url: '/#experience',
  },
  {
    title: 'Proyectos',
    label: 'proyectos',
    url: '/#projects',
  },
  {
    title: 'Sobre mí',
    label: 'sobre-mi',
    url: '/#about-me',
  },
  {
    title: 'Contacto',
    label: 'contacto',
    url: 'mailto:alejandro.oliva2409@gmail.com',
  },
];
---

<header class='mt-4 flex justify-center'>
  <nav class='w-wrapper'>
    <ul
      class='mx-auto flex w-fit flex-wrap justify-center gap-1 rounded-full border border-gray-200 bg-white/70 px-2 py-1 text-sm shadow-sm backdrop-blur-md'
    >
      {
        navItems.map((item) => (
          <li>
            <a
              class='block rounded-full px-3 py-1.5 transition-colors hover:bg-gray-100 hover:text-yellow-600'
              aria-label={item.label}
              href={item.url}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
