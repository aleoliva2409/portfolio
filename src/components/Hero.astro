---
import MailIcon from '@/assets/icons/Mail.astro';
import MediaLink from './MediaLink.astro';
import GithubIcon from '@/assets/icons/Github.astro';
import LinkedInIcon from '@/assets/icons/LinkedIn.astro';
import SectionContainer from './SectionContainer.astro';
import { getLang, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<SectionContainer id='Hero' classes='my-16 sm:my-24'>
  <div
    class='anim-fade-in flex flex-col items-start gap-4 sm:flex-row sm:items-center'
  >
    <img
      class='size-20 rounded-full object-cover'
      src='/me.webp'
      alt='Alejandro Oliva'
      width='80'
      height='80'
      fetchpriority='high'
    />
    <a
      href='https://www.linkedin.com/in/aleoliva-dev/'
      target='_blank'
      rel='noopener noreferrer'
      class='rounded-full border border-brand/40 bg-brand/10 px-2.5 py-1 text-brand dark:border-brand-dark/40 dark:bg-brand-dark/10 dark:text-brand-dark'
    >
      {t('hero.available')}
    </a>
  </div>
  <h1 class='anim-fade-in anim-delay-1 py-5 text-4xl font-bold sm:text-5xl'>
    {t('hero.greeting')} <span class='text-brand dark:text-brand-dark'>Alejandro</span>
  </h1>
  <p class='anim-fade-in anim-delay-2 max-w-2xl text-lg leading-8'>
    {t('hero.intro')}{' '}
    <span class='font-bold text-accent dark:text-accent-dark'>
      {t('hero.highlight')}{' '}
    </span>
    {t('hero.outro')}
  </p>
  <nav class='anim-fade-in anim-delay-3 my-6 flex flex-wrap gap-2'>
    <MediaLink href='mailto:alejandro.oliva2409@gmail.com'>
      <MailIcon class='mr-1 size-4' />
      {t('hero.contact')}
    </MediaLink>
    <MediaLink href='https://www.linkedin.com/in/aleoliva-dev/'>
      <LinkedInIcon class='mr-1 size-4' />
      LinkedIn
    </MediaLink>
    <MediaLink href='https://github.com/aleoliva2409'>
      <GithubIcon class='mr-1 size-4' />
      GitHub
    </MediaLink>
  </nav>
</SectionContainer>
