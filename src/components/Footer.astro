---
import { getLang, useTranslations } from '@/i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class='w-wrapper mx-auto px-4 pb-8 pt-16 sm:px-6'>
  <div
    class='flex flex-col gap-3 border-t border-line pt-6 text-sm text-ink/60 dark:border-line-dark dark:text-ink-dark/60 sm:flex-row sm:items-center sm:justify-between'
  >
    <span>© {currentYear} Alejandro Oliva</span>

    <span>
      {t('footer.basedOn')} <a
        href='https://github.com/midudev/porfolio.dev'
        target='_blank'
        rel='noopener noreferrer'
        class='underline transition-colors hover:text-accent dark:hover:text-accent-dark'
        >porfolio.dev</a
      > {t('footer.by')} · <a
        href={`https://creativecommons.org/licenses/by-nc/4.0/deed.${lang}`}
        target='_blank'
        rel='noopener noreferrer'
        class='underline transition-colors hover:text-accent dark:hover:text-accent-dark'
        >CC BY-NC 4.0</a
      >
    </span>

    <a
      href='mailto:alejandro.oliva2409@gmail.com'
      class='transition-colors hover:text-accent dark:hover:text-accent-dark'
    >
      {t('footer.contact')}
    </a>
  </div>
</footer>
