---
import GithubIcon from '@/assets/icons/Github.astro';
import HourglassIcon from '@/assets/icons/Hourglass.astro';
import { getLang, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
---

<article
  class='flex flex-col items-center rounded-2xl border-2 border-dashed border-line bg-surface/60 px-6 py-12 text-center dark:border-line-dark dark:bg-surface-dark/60'
>
  <span
    class='inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-sm font-medium text-accent dark:border-accent-dark/40 dark:bg-accent-dark/10 dark:text-accent-dark'
  >
    <span class='relative flex size-2' aria-hidden='true'>
      <span
        class='absolute inline-flex size-full rounded-full bg-accent opacity-75 motion-safe:animate-ping dark:bg-accent-dark'
      ></span>
      <span
        class='relative inline-flex size-2 rounded-full bg-accent dark:bg-accent-dark'
      ></span>
    </span>
    {t('projects.badge')}
  </span>

  <HourglassIcon
    class='mt-6 size-12 text-brand dark:text-brand-dark'
    aria-hidden='true'
  />

  <h3 class='mt-4 text-2xl font-semibold'>{t('projects.title')}</h3>

  <p class='mt-3 max-w-md leading-7 text-ink/70 dark:text-ink-dark/70'>
    {t('projects.description')}
  </p>

  <a
    href='https://github.com/aleoliva2409'
    target='_blank'
    rel='noopener noreferrer'
    class='mt-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-4 py-1.5 text-ink transition-colors hover:border-accent hover:text-accent dark:border-line-dark dark:bg-surface-dark/80 dark:text-ink-dark dark:hover:border-accent-dark dark:hover:text-accent-dark'
  >
    <GithubIcon class='size-4' />
    {t('projects.github')}
  </a>
</article>
