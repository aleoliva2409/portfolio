---
import SystemIcon from '@/assets/icons/SystemIcon.astro';

const themes = [
  { label: 'Claro', value: 'light' },
  { label: 'Oscuro', value: 'dark' },
  { label: 'Sistema', value: 'system' },
];
---

<div class='relative'>
  <button
    id='dropdown-button'
    class='cursor-pointer rounded-md p-1.5 text-ink transition hover:scale-110 dark:text-ink-dark'
    type='button'
    aria-label='Cambiar tema'
  >
    <SystemIcon />
  </button>

  <ul
    id='dropdown-menu'
    class='absolute right-0 z-10 hidden w-32 rounded-md border border-line bg-surface p-1 text-sm shadow-lg dark:border-line-dark dark:bg-surface-dark'
  >
    {
      themes.map((theme) => (
        <li
          data-theme={theme.value}
          class='cursor-pointer rounded-md px-3 py-2 text-ink hover:bg-brand/10 hover:text-brand dark:text-ink-dark dark:hover:bg-brand-dark/10 dark:hover:text-brand-dark'
        >
          {theme.label}
        </li>
      ))
    }
  </ul>
</div>

<script>
  const button = document.getElementById('dropdown-button');
  const menu = document.getElementById('dropdown-menu');
  const options = document.querySelectorAll<HTMLElement>('[data-theme]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const applyTheme = (theme: string) => {
    const isDark = theme === 'dark' || (theme === 'system' && media.matches);

    document.documentElement.classList.toggle('dark', isDark);
  };

  button?.addEventListener('click', (event) => {
    event.stopPropagation();
    menu?.classList.toggle('hidden');
  });

  options.forEach((option) => {
    option.addEventListener('click', () => {
      const theme = option.dataset.theme ?? 'system';

      localStorage.setItem('theme', theme);
      applyTheme(theme);
      menu?.classList.add('hidden');
    });
  });
</script>
