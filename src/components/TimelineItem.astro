---
import type { Experience } from './Timeline.astro';

export interface Props extends Experience {}

const { position, company, period, description } = Astro.props;
---

<li class='mb-12 ml-5 md:ml-8'>
  <div
    class='absolute -inset-s-2 mt-1.5 size-3.5 rounded-full border border-white bg-gray-300'
  >
  </div>

  <div class='grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8'>
    <div>
      <h3 class='text-lg font-semibold'>
        {position}
      </h3>

      <h4 class='mt-1 text-lg font-medium'>
        {company}
      </h4>

      <time class='mt-2 block text-sm text-gray-400'>
        {period}
      </time>
    </div>

    <p class='leading-7 text-gray-400'>
      {description}
    </p>
  </div>
</li>
