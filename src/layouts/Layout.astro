---
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang, languages, type Lang } from '@/i18n/ui';
import { getLang, useTranslations } from '@/i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const alternateUrl = (locale: Lang) =>
  new URL(getRelativeLocaleUrl(locale), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={t('meta.description')} />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{t('meta.title')}</title>
    {
      (Object.keys(languages) as Lang[]).map((locale) => (
        <link rel='alternate' hreflang={locale} href={alternateUrl(locale)} />
      ))
    }
    <link rel='alternate' hreflang='x-default' href={alternateUrl(defaultLang)} />

    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches;

      if (theme === 'dark' || (theme !== 'light' && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body
    class='bg-surface font-sans text-ink transition-colors dark:bg-surface-dark dark:text-ink-dark'
  >
    <div
      class='fixed inset-0 -z-10 bg-surface
  bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(15,118,110,0.12),rgba(245,247,250,0.96))]
  dark:bg-surface-dark
  dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(94,234,212,0.10),rgba(16,24,32,0.98))]'
    >
    </div>
    <Header />
    <main class='w-wrapper mx-auto px-4 pt-20 sm:px-6'>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* color-scheme: light dark; */
  }
</style>
