---
import Layout from '@/layouts/Layout.astro';
import ProjectCard from '@/components/ProjectCard.astro';

import Briefcase from '@/assets/icons/Briefcase.astro';
import Code from '@/assets/icons/Code.astro';
import CodeDots from '@/assets/icons/CodeDots.astro';
import AboutMe from '@/assets/icons/AboutMe.astro';

import Hero from '@/components/Hero.astro';
import Header from '@/components/Header.astro';
import Timeline from '@/components/Timeline.astro';
import SectionContainer from '@/components/SectionContainer.astro';
---

<Layout
  lang='es'
  title='Alejandro Oliva'
  description='Me llamo Alejandro Oliva, soy full stack developer con más de 5 años de experiencia.'
>
  <Header />

  <Hero />

  <SectionContainer id='experience' classes='my-16 scroll-mt-24'>
    <h2 class='flex items-center text-3xl font-medium pb-5'>
      <span class='mr-2'><Briefcase class='size-8' /></span>
      Experiencia laboral
    </h2>

    <Timeline />
  </SectionContainer>
  <SectionContainer id='skills' classes='my-16 scroll-mt-24'>
    <h2 class='flex items-center pb-5 text-3xl font-medium'>
      <span class='mr-2'><Code class='size-7' /></span>
      Habilidades
    </h2>

    <div class='flex flex-wrap gap-3'>
      <span>Astro</span>
      <span>JavaScript</span>
      <span>TypeScript</span>
      <span>React</span>
      <span>Node.js</span>
      <span>Tailwind CSS</span>
    </div>
  </SectionContainer>

  <SectionContainer id='projects' classes='my-16 scroll-mt-24'>
    <h2 class='flex items-center pb-5 text-3xl font-medium'>
      <span class='mr-2'><CodeDots class='size-8' /></span>
      Proyectos
    </h2>

    <div class='grid gap-6 md:grid-cols-2'>
      <ProjectCard
        title='Mi proyecto'
        description='Aplicación web creada para resolver un problema real.'
        technologies='Astro · TypeScript · Tailwind CSS'
        image='/code.webp'
        codeUrl='https://github.com/tu-usuario/mi-proyecto'
        demoUrl='https://mi-proyecto.com'
      />
      <ProjectCard
        title='Mi proyecto'
        description='Aplicación web creada para resolver un problema real.'
        technologies='Astro · TypeScript · Tailwind CSS'
        image='/code.webp'
        codeUrl='https://github.com/tu-usuario/mi-proyecto'
        demoUrl='https://mi-proyecto.com'
      />
      <ProjectCard
        title='Mi proyecto'
        description='Aplicación web creada para resolver un problema real.'
        technologies='Astro · TypeScript · Tailwind CSS'
        image='/code.webp'
        codeUrl='https://github.com/tu-usuario/mi-proyecto'
        demoUrl='https://mi-proyecto.com'
      />
    </div>
  </SectionContainer>

  <SectionContainer id='about-me' classes='my-16 scroll-mt-24'>
    <h2 class='flex items-center pb-5 text-3xl font-medium'>
      <span class='mr-2'><AboutMe class='size-8' /></span>
      Sobre mí
    </h2>

    <p class='max-w-2xl text-lg leading-8'>
      Soy desarrollador Full Stack y me gusta crear aplicaciones web útiles,
      simples y fáciles de mantener. Disfruto aprender nuevas tecnologías,
      resolver problemas y trabajar en equipo.
    </p>
  </SectionContainer>
</Layout>
