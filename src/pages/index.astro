---
import Layout from '@/layouts/Layout.astro';

import Header from '@/components/Header.astro';
import Timeline from '@/components/Timeline.astro';
// import Button from '@/components/Button.astro';
---

<Layout>
  <Header />
  <main class='w-wrapper mx-auto'>
    <section class='w-[70%]'>
      <div class='flex flex-row'>
        <img
          class='rounded-full size-16'
          src='/me.webp'
          alt='Alejandro Oliva'
        />
        <button>Disponible para trabajar</button>
      </div>
      <h1 class='font-bold text-4xl py-5'>Hola, soy Alejandro Oliva</h1>
      <p class='text-lg'>
        +3 años de experiencia. Desarrollodor Full Stack, <span
          class='font-bold text-yellow-400'
          >actualmente trabajando en Banco Galicia,</span
        > uno de las bancos mas importantes de Argentina. Si quieres contactarme,
        te dejo mis redes aquí abajo
      </p>
      <div>
        <button>Contáctame</button>
        <button>LinkedIn</button>
      </div>
    </section>
    <section>
      <h2 class='text-3xl font-medium'><span>.</span>Experiencia laboral</h2>
      <Timeline />
    </section>
    <section>
      <h2 class='text-3xl font-medium'>Habilidades</h2>
      <div></div>
      <p></p>
    </section>
    <section>
      <h2 class='text-3xl font-medium'>Proyectos</h2>
      <div></div>
      <p></p>
      <div>
        <button></button>
        <button></button>
      </div>
    </section>
    <section>
      <h2 class='text-3xl font-medium'>Contáctame</h2>
      <div></div>
      <p></p>
    </section>
  </main>
  <!-- <Button /> -->
</Layout>
