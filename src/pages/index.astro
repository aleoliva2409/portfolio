---
import Layout from '@/layouts/Layout.astro';

import Briefcase from '@/assets/icons/Briefcase.astro';

import Header from '@/components/Header.astro';
import Timeline from '@/components/Timeline.astro';
import Button from '@/components/Button.astro';
---

<Layout
  lang='es'
  title='Alejandro Oliva'
  description='Me llamo Alejandro Oliva, soy full stack developer con más de 3 años de experiencia.'
>
  <Header />

  <section class='w-[70%] my-10'>
    <div class='flex flex-row items-center'>
      <img class='rounded-full size-16' src='/me.webp' alt='Alejandro Oliva' />
      <Button classes='ml-4'>Disponible para trabajar</Button>
    </div>
    <h1 class='font-bold text-4xl py-5'>Hola, soy Alejandro Oliva</h1>
    <p class='text-lg'>
      +3 años de experiencia. Desarrollodor Full Stack, <span
        class='font-bold text-yellow-400'
        >actualmente trabajando en Banco Galicia,</span
      > uno de las bancos mas importantes de Argentina. Si quieres contactarme, te
      dejo mis redes aquí abajo
    </p>
    <div>
      <Button>Contáctame</Button>
      <Button>Trabajando</Button>
    </div>
  </section>

  <section class='my-10'>
    <h2 class='flex items-center text-3xl font-medium pb-5'>
      <span class='mr-2'><Briefcase class='size-8' /></span>
      Experiencia laboral
    </h2>
    <Timeline />
  </section>
  <section class='my-10'>
    <h2 class='text-3xl font-medium'>Habilidades</h2>
    <div></div>
    <p></p>
  </section>

  <section class='my-10'>
    <h2 class='text-3xl font-medium'>Proyectos</h2>
    <div></div>
    <p></p>
    <div>
      <button></button>
      <button></button>
    </div>
  </section>

  <section class='my-10'>
    <h2 class='text-3xl font-medium'>Contáctame</h2>
    <div></div>
    <p></p>
  </section>
</Layout>
